# ===== Supabase (local: supabase start 출력값) =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # 서버 전용. 클라이언트 노출 금지

# ===== Claude API (서버 Route Handler 전용) =====
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# ===== 토스페이먼츠 (테스트 키) =====
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ===== 기타 =====
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 검색엔진 색인 허용 여부 (서버 전용). 공개 전에는 비워 둔다 —
# robots.txt 와 전 페이지 메타가 이 값 하나를 본다(S3-10).
ALLOW_INDEXING=
