{
  "name": "weddingclear",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:bundle": "node scripts/check-secrets.mjs --bundle",
    "check:audit": "node scripts/check-audit.mjs",
    "check:coverage-table": "node scripts/check-coverage-table.mjs",
    "check:tables": "node scripts/check-doc-tables.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run check:secrets && npm run check:coverage-table && npm run check:tables && npm run assets:check",
    "seed:accounts": "node --env-file=.env.local scripts/seed-accounts.mjs",
    "env:sync": "node scripts/sync-env.mjs",
    "env:check": "node scripts/sync-env.mjs --check",
    "assets:gen": "node scripts/generate-placeholders.mjs",
    "assets:check": "node scripts/check-assets.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:types": "supabase gen types typescript --local > types/database.ts",
    "db:rls": "node --env-file=.env.local scripts/rls-check.mjs",
    "audit:routes": "node scripts/audit-routes.mjs",
    "audit:screens": "node --env-file=.env.local --experimental-websocket scripts/audit-runtime.mjs --screens --out=tmp/audit-screens.json",
    "audit:api": "node --env-file=.env.local --experimental-websocket scripts/audit-runtime.mjs --api --out=tmp/audit-api.json",
    "audit:runtime": "node --env-file=.env.local --experimental-websocket scripts/audit-runtime.mjs",
    "audit:report": "node scripts/audit-report.mjs",
    "check:escrow": "node --env-file=.env.local scripts/check-escrow-release.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.0",
    "supabase": "^2.22.6",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
